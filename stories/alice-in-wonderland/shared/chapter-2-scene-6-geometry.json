  "atlasContract": ".artifacts/alice-in-wonderland/chapter-2/scene-6-gates/bill-atlas-contract.json",
  "durationSeconds": 71.2,
  "steps": [
    {
      "moment": 1,
      "location": "I",
      "seconds": 3,
      "speaker": "Sin texto",
      "content": "Apertura idéntica al cierre de S5: misma Alice, props y cámara.",
      "advanceLocked": true
    },
    {
      "moment": 2,
      "location": "E",
      "seconds": 0.7,
      "speaker": "Sin texto",
      "content": "Crossfade interior → exterior.",
      "advanceLocked": true
    },
    {
      "moment": 3,
      "location": "E",
      "seconds": 2.5,
      "speaker": "Sin texto",
      "content": "El Conejo prueba la puerta; no logra abrirla.",
      "advanceLocked": true
    },
    {
      "moment": 4,
      "location": "E",
      "seconds": 3,
      "speaker": "Rabbit",
      "content": "Something enormous is blocking my door!",
      "advanceLocked": false
    },
    {
      "moment": 5,
      "location": "E",
      "seconds": 3,
      "speaker": "Rabbit",
      "content": "Bill! Bring your ladder. Try the chimney!",
      "advanceLocked": false
    },
    {
      "moment": 6,
      "location": "E",
      "seconds": 3,
      "speaker": "Sin texto",
      "content": "Bill entra por la verja con su escalera; se acerca al Conejo.",
      "advanceLocked": true
    },
    {
      "moment": 7,
      "location": "E",
      "seconds": 3.5,
      "speaker": "Bill",
      "content": "The chimney? All right. I will try.",
      "advanceLocked": false
    },
    {
      "moment": 8,
      "location": "E",
      "seconds": 5,
      "speaker": "Sin texto",
      "content": "Bill despliega su escalera y la apoya contra el alero derecho.",
      "advanceLocked": true
    },
    {
      "moment": 9,
      "location": "E",
      "seconds": 5,
      "speaker": "Sin texto",
      "content": "Sube la escalera y continúa por la vertiente del techo hasta el conducto.",
      "advanceLocked": true
    },
    {
      "moment": 10,
      "location": "E",
      "seconds": 2,
      "speaker": "Sin texto",
      "content": "Bill se agacha y desaparece por la boca de la chimenea.",
      "advanceLocked": true
    },
    {
      "moment": 11,
      "location": "I",
      "seconds": 0.7,
      "speaker": "Sin texto",
      "content": "Crossfade exterior → interior.",
      "advanceLocked": true
    },
    {
      "moment": 12,
      "location": "I",
      "seconds": 1.5,
      "speaker": "Sin texto",
      "content": "Polvo y golpes progresan hacia abajo dentro del conducto de piedra.",
      "advanceLocked": true
    },
    {
      "moment": 13,
      "location": "I",
      "seconds": 7,
      "speaker": "Alice",
      "content": "Someone is coming down the chimney! One little kick sends him back up!",
      "advanceLocked": false,
      "dialogueParts": [
        {
          "id": "alice-c2-bill-13",
          "seconds": 3.5
        },
        {
          "id": "alice-c2-bill-13-kick",
          "seconds": 3.5
        }
      ]
    },
    {
      "moment": 14,
      "location": "I",
      "seconds": 1.2,
      "speaker": "Sin texto",
      "content": "Alice se sacude contra el hogar; un golpe y polvo suben por el conducto. Sprite entero, sin zapato añadido.",
      "advanceLocked": true
    },
    {
      "moment": 15,
      "location": "E",
      "seconds": 0.7,
      "speaker": "Sin texto",
      "content": "Crossfade interior → exterior; el vuelo todavía no empieza.",
      "advanceLocked": true
    },
    {
      "moment": 16,
      "location": "E",
      "seconds": 4.5,
      "speaker": "Sin texto",
      "content": "Bill sale desde el tope, describe un arco y aterriza sentado junto al arbusto derecho.",
      "advanceLocked": true
    },
    {
      "moment": 17,
      "location": "E",
      "seconds": 3,
      "speaker": "Bill",
      "content": "I think I shall stay out here.",
      "advanceLocked": false
    },
    {
      "moment": 18,
      "location": "E",
      "seconds": 4,
      "speaker": "Rabbit",
      "content": "That did not work. Toss a few little pebbles down the chimney!",
      "advanceLocked": false
    },
    {
      "moment": 19,
      "location": "E",
      "seconds": 4,
      "speaker": "Sin texto",
      "content": "Three pebbles follow staggered monotonic-left arcs into chimney top925,210.",
      "advanceLocked": true
    },
    {
      "moment": 20,
      "location": "I",
      "seconds": 0.7,
      "speaker": "Sin texto",
      "content": "Crossfade exterior → interior. Se conserva la identidad y el número de los tres guijarros.",
      "advanceLocked": true
    },
    {
      "moment": 21,
      "location": "I",
      "seconds": 2,
      "speaker": "Sin texto",
      "content": "Three pebbles fall out of the cold gray hearth and roll to the three cake coordinates.",
      "advanceLocked": true
    },
    {
      "moment": 22,
      "location": "I",
      "seconds": 2,
      "speaker": "Sin texto",
      "content": "Cada guijarro se convierte visiblemente en un pastelito; breve destello, sin movimiento de Alice.",
      "advanceLocked": true
    },
    {
      "moment": 23,
      "location": "I",
      "seconds": 4,
      "speaker": "Alice",
      "content": "Those pebbles have turned into little cakes!",
      "advanceLocked": false
    },
    {
      "moment": 24,
      "location": "I",
      "seconds": 3,
      "speaker": "Alice",
      "content": "Perhaps one of them can help me get out.",
      "advanceLocked": false
    }
  ],
