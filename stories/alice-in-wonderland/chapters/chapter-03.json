          "type": "text",
          "c3Beat": 6,
          "camera": {
            "hold": true
          },
          "effects": {},
          "who": "alice",
          "text": "My name is Alice. At least, that part has stayed the same.",
          "readingDurationMs": 6000
        },
        {
          "id": "alice-c3-who-07",
          "type": "text",
          "c3Beat": 7,
          "camera": {
            "hold": true
          },
          "effects": {},
          "who": "alice",
          "text": "I keep changing size, and nothing feels familiar anymore.",
          "readingDurationMs": 7000
        },
        {
          "id": "alice-c3-who-08",
          "type": "text",
          "c3Beat": 8,
          "camera": {
            "hold": true
          },
          "effects": {},
          "who": "caterpillar",
          "text": "What has changed, besides your height?",
          "readingDurationMs": 7000
        },
        {
          "id": "alice-c3-who-09",
          "type": "text",
          "c3Beat": 9,
          "camera": {
            "hold": true
          },
          "effects": {},
          "who": "alice",
          "text": "Even the things I knew by heart come out wrong.",
          "readingDurationMs": 7000
        },
