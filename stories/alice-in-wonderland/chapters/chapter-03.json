    {
      "id": "alice-c3-s2",
      "name": "One Side, the Other",
      "durationPhase": "initial",
      "steps": [
        {
          "id": "alice-c3-side-02",
          "type": "text",
          "s2Beat": 2,
          "camera": {
            "preventDissolve": true,
            "hold": true
          },
          "who": "alice",
          "text": "I'd like to choose my size, instead of changing without warning.",
          "readingDurationMs": 7000
        },
        {
          "id": "alice-c3-side-03",
          "type": "text",
          "s2Beat": 3,
          "camera": {
            "preventDissolve": true,
            "hold": true
          },
          "who": "caterpillar",
          "text": "Keep your temper. We can begin with something you remember.",
          "readingDurationMs": 5000
        },
        {
          "id": "alice-c3-side-04",
          "type": "text",
          "s2Beat": 4,
          "camera": {
            "preventDissolve": true,
            "hold": true
          },
          "who": "caterpillar",
          "text": "Can you begin the poem about Father William?",
          "readingDurationMs": 6000
        },
        {
          "id": "alice-c3-side-05",
          "type": "text",
          "s2Beat": 5,
          "camera": {
            "preventDissolve": true,
            "hold": true
          },
          "who": "alice",
          "text": "Father William balanced a fish on his hat... That's not right.",
          "readingDurationMs": 7000
        },
        {
          "id": "alice-c3-side-06",
          "type": "text",
          "s2Beat": 6,
          "camera": {
            "preventDissolve": true,
            "hold": true
          },
          "who": "caterpillar",
          "text": "The words have changed. What size would you like to be?",
          "readingDurationMs": 5000
        },
        {
          "id": "alice-c3-side-07",
          "type": "text",
          "s2Beat": 7,
          "camera": {
            "preventDissolve": true,
            "hold": true
          },
          "who": "alice",
          "text": "A little taller, please. But no more shooting up into the trees.",
          "readingDurationMs": 7000
        },
        {
          "id": "alice-c3-side-08",
          "type": "text",
          "s2Beat": 8,
          "camera": {
            "preventDissolve": true,
            "hold": true
          },
          "who": "caterpillar",
          "text": "Eating one side makes you taller. The other makes you smaller.",
          "readingDurationMs": 7000
        },
        {
          "id": "alice-c3-side-09",
          "type": "text",
          "s2Beat": 9,
          "camera": {
            "preventDissolve": true,
            "hold": true
          },
          "who": "alice",
          "text": "One side of what?",
          "readingDurationMs": 5000
        },
        {
          "id": "alice-c3-side-10",
          "type": "text",
          "s2Beat": 10,
          "camera": {
            "preventDissolve": true,
            "hold": true
          },
          "who": "caterpillar",
          "text": "The mushroom. You'll have to find out which side is which.",
          "readingDurationMs": 6000
        },
        {
          "id": "alice-c3-side-11",
          "type": "action",
          "s2Beat": 11,
          "camera": {
            "preventDissolve": true,
            "hold": true
          },
          "duration": 3000,
          "effects": {},
          "caption": "clear"
        },
        {
          "id": "alice-c3-side-12",
          "type": "action",
          "s2Beat": 12,
          "camera": {
            "preventDissolve": true,
            "hold": false,
            "pan": {
              "axis": "y",
