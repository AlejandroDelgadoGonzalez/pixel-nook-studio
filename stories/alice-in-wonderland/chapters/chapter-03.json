          "type": "text",
          "c3Beat": 3,
          "camera": {
            "hold": true
          },
          "effects": {},
          "who": "alice",
          "text": "Perhaps you and your water pipe know the way.",
          "readingDurationMs": 5000
        },
        {
          "id": "alice-c3-who-04",
          "type": "action",
          "c3Beat": 4,
          "camera": {
            "hold": true
          },
          "effects": {},
          "duration": 5000,
          "caption": "clear"
        },
        {
          "id": "alice-c3-who-05",
          "type": "text",
          "c3Beat": 5,
          "camera": {
            "hold": true
          },
          "effects": {},
          "who": "caterpillar",
          "text": "Who are you?",
          "readingDurationMs": 7000
        },
        {
          "id": "alice-c3-who-06",
          "type": "text",
          "c3Beat": 6,
          "camera": {
            "hold": true
          },
          "effects": {},
          "who": "alice",
          "text": "My name is Alice. At least, that part has stayed the same.",
          "readingDurationMs": 6000
        },
        {
          "id": "alice-c3-who-07",
          "type": "text",
          "c3Beat": 7,
          "camera": {
            "hold": true
          },
          "effects": {},
          "who": "alice",
          "text": "I keep changing size, and nothing feels familiar anymore.",
          "readingDurationMs": 7000
        },
        {
          "id": "alice-c3-who-08",
          "type": "text",
          "c3Beat": 8,
          "camera": {
            "hold": true
          },
          "effects": {},
          "who": "caterpillar",
          "text": "What has changed, besides your height?",
          "readingDurationMs": 7000
        },
        {
          "id": "alice-c3-who-09",
          "type": "text",
          "c3Beat": 9,
          "camera": {
            "hold": true
          },
          "effects": {},
          "who": "alice",
          "text": "Even the things I knew by heart come out wrong.",
          "readingDurationMs": 7000
        },
        {
          "id": "alice-c3-who-10",
          "type": "text",
          "c3Beat": 10,
          "camera": {
            "hold": true
          },
          "effects": {},
          "who": "alice",
          "text": "I would like to feel like myself again.",
          "readingDurationMs": 6000
        },
        {
          "id": "alice-c3-who-11",
          "type": "text",
          "c3Beat": 11,
          "camera": {
            "hold": true
          },
          "effects": {},
          "who": "caterpillar",
          "text": "Then take your time. Begin with what you want to understand.",
          "readingDurationMs": 10000
        }
      ],
      "videoExport": {
        "endAtLastBeat": true
      },
