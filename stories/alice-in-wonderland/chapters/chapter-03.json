          "camera": {
            "preventDissolve": true,
            "hold": true
          },
          "staging": "Se detiene antes de recoger B; intención, sin narrador.",
          "who": "alice",
          "text": "And this one can stay in my other hand.",
          "readingDurationMs": 4000
        },
        {
          "id": "alice-c3-little-06",
          "type": "action",
          "s3Beat": 6,
          "camera": {
            "preventDissolve": true,
            "hold": true
          },
          "staging": "Raíz fija, toma B del lado izquierdo del tallo y lo conserva en la mano.",
          "duration": 3000,
          "caption": "clear",
          "effects": {
            "mushroomTrial": {
              "x": 411,
              "y": 608,
              "scale": 0.32,
              "B": {
                "owner": "alice",
                "location": "hand",
                "remaining": 1
              }
            }
