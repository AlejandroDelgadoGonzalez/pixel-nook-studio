          "type": "text",
          "s3Beat": 8,
          "camera": {
            "preventDissolve": true,
            "hold": true
          },
          "staging": "B se aproxima a la boca; decide empezar por una cantidad pequeña.",
          "who": "alice",
          "text": "Just a crumb. I can always try again.",
          "readingDurationMs": 6000
