          "camera": {
            "hold": false
          },
          "effects": {},
          "who": "alice",
          "text": "Oh! I didn't see you there.",
          "captionStartMs": 6000,
          "readingDurationMs": 9000,
          "during": {
            "duration": 6000,
            "lockUntilComplete": true,
            "initial": {},
            "effects": {}
          }
