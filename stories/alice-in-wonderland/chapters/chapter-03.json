        {
          "id": "alice-c3-little-09",
          "type": "action",
          "s3Beat": 9,
          "camera": {
            "preventDissolve": true,
            "hold": true
          },
          "staging": "Muerde B y baja la mano; crecimiento uniforme con ambos pies anclados. B conserva una porción visible.",
