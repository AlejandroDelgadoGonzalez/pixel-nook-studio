          "caption": "clear"
        },
        {
          "id": "alice-c3-side-13",
          "type": "text",
          "s2Beat": 13,
          "camera": {
            "preventDissolve": true,
            "hold": true
          },
          "who": "alice",
          "text": "I'll try a little, and see what changes.",
          "readingDurationMs": 4000
        }
