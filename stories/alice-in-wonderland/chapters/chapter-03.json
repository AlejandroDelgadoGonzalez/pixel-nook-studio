          "camera": {
            "preventDissolve": true,
            "hold": true
          },
          "staging": "De pie; decide cómo distinguir las dos porciones.",
          "who": "alice",
          "text": "Two sides. I will keep them separate.",
          "readingDurationMs": 6000
        },
        {
          "id": "alice-c3-little-03",
          "type": "action",
          "s3Beat": 3,
          "camera": {
            "preventDissolve": true,
            "hold": true
          },
          "staging": "Con raíz fija, toca el tallo derecho, separa A y lo guarda en el bolsillo; termina con mano libre.",
          "duration": 3000,
          "caption": "clear",
          "effects": {
            "mushroomTrial": {
              "x": 575,
              "y": 608,
              "scale": 0.32,
