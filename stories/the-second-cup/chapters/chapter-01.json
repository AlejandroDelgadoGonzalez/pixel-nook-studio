  "scenes": [
    {
      "id": "warm-cup",
      "name": "The cup that waited",
      "targetSeconds": 70,
      "atmosphere": {
        "water": 0.035,
        "wind": 0.018,
        "birds": 0.003,
        "village": 0,
        "music": 0
      },
      "media": {
        "type": "animation"
      },
      "steps": [
        {
          "type": "text",
          "id": "cup-1",
          "text": "Mara always left the blue cup empty. Tonight, a thin ribbon of steam rose from it.",
          "pauseMs": 1800,
          "kind": "narration"
        },
        {
          "type": "text",
          "id": "cup-2",
          "text": "The amber cup beside it was still cold. She had not poured either one.",
          "pauseMs": 1800,
          "kind": "narration"
        },
        {
          "type": "action",
          "id": "touch-the-cup",
          "duration": 900,
          "effects": {
            "actors": {
              "mara": {
                "pose": "reach"
              }
            },
            "view": "cups"
          }
        },
        {
          "type": "action",
          "id": "lift-blue",
          "duration": 1400,
          "effects": {
            "props": {
              "blue": {
                "x": 636,
                "y": 505,
                "owner": "mara"
              }
            },
            "actors": {
              "mara": {
                "pose": "reach"
              }
            }
          }
        },
        {
          "type": "text",
          "id": "cup-3",
          "text": "She lifted the blue cup. Warmth settled into her fingers, gentle as a hand finding hers.",
          "pauseMs": 1800,
          "kind": "narration"
        },
        {
          "type": "text",
          "id": "cup-4",
          "text": "That’s odd. I’ve been alone all afternoon.",
          "pauseMs": 1800,
          "who": "mara"
        },
        {
          "type": "action",
          "id": "return-blue",
          "duration": 1500,
          "effects": {
            "props": {
              "blue": {
                "x": 644,
                "y": 492,
                "owner": "table"
              }
            }
          }
        },
        {
          "type": "action",
          "id": "someone-at-the-door",
          "duration": 2400,
          "effects": {
            "view": "door",
            "actors": {
              "ellis": {
                "visible": 1,
                "facing": "front"
              }
            }
          }
        },
        {
          "type": "text",
          "id": "cup-5",
          "text": "At the cottage door stood a stranger in a teal cardigan. He carried nothing, except the look of someone considering an apology.",
          "pauseMs": 1800,
          "kind": "narration"
        },
        {
          "type": "text",
          "id": "cup-6",
          "text": "I’m sorry. I thought the second cup meant someone was welcome.",
          "pauseMs": 1800,
          "who": "ellis"
        },
        {
          "type": "action",
          "id": "answer-from-terrace",
          "duration": 2200,
          "effects": {
            "view": "table"
          }
        },
        {
          "type": "text",
          "id": "cup-7",
          "text": "It did. I just hadn’t expected anyone to understand.",
          "pauseMs": 3400,
          "who": "mara"
        }
      ],
      "estimatedSeconds": 64.4
    },
