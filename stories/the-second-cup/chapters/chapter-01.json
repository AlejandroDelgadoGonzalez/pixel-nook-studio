        {
          "type": "action",
          "id": "settle-at-the-table",
          "duration": 1100,
          "effects": {
            "view": "conversation",
            "actors": {
              "ellis": {
                "pose": "idle",
                "facing": "left"
              }
            }
          }
        },
        {
          "type": "text",
          "id": "cup-8",
          "text": "He crossed the terrace and stopped beside the table, leaving enough space for Mara to send him away.",
          "pauseMs": 1800,
          "kind": "narration"
        },
        {
          "type": "text",
          "id": "cup-9",
          "text": "I’m Ellis. Next door. I saw you setting this out every evening.",
          "pauseMs": 1800,
          "who": "ellis"
        },
        {
          "type": "text",
          "id": "cup-10",
          "text": "My sister used to visit at this hour. After she moved, I kept bringing out two cups.",
          "pauseMs": 1800,
          "who": "mara"
        },
        {
          "type": "text",
          "id": "cup-11",
          "text": "I waited by the door yesterday. I couldn’t work out how to say hello.",
          "pauseMs": 1800,
          "who": "ellis"
        },
        {
          "type": "action",
          "id": "reach-for-teapot",
          "duration": 1100,
          "effects": {
            "actors": {
              "ellis": {
                "pose": "reach"
              }
            },
            "props": {
              "pot": {
                "x": 782,
                "y": 505,
                "owner": "ellis"
              }
            },
            "view": "pour"
          }
        },
        {
          "type": "action",
          "id": "tip-the-teapot",
          "duration": 1100,
          "effects": {
            "props": {
              "pot": {
                "x": 721,
                "y": 465,
                "tilt": 0.3
              }
            },
            "pour": 1
