                "pose": "walk",
                "facing": "left"
              }
            }
          }
        },
        {
          "id": "odyssey-c2-s3-clarity-destination",
          "type": "text",
          "kind": "narration",
          "text": "He would sail away to ask people who had fought at Troy about his father. Eurycleia, his old nurse, had packed food."
        },
        {
          "id": "odyssey-c2-s3-p8",
          "type": "text",
          "kind": "narration",
          "who": null,
          "text": "Telemachus stepped aboard. Speaking had not solved his trouble. It had made him ready to move."
        },
        {
          "id": "odyssey-c2-s3-leave-ithaca",
          "type": "action",
          "duration": 2800,
          "effects": {
            "view": "departing",
