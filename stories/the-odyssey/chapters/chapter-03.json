        {
          "id": "odyssey-c3-s3-clarity-palace",
          "type": "text",
          "kind": "narration",
          "text": "Nausicaa showed Odysseus the way from the river to her parents’ palace. He carried the bread she had given him."
        },
        {
          "id": "odyssey-c3-s3-p1",
          "type": "text",
          "kind": "narration",
          "who": null,
          "text": "Inside, Queen Arete, Nausicaa’s mother, watched the stranger approach the table."
        },
        {
          "id": "odyssey-c3-s3-p2",
          "type": "text",
          "kind": "dialogue",
          "who": "arete",
          "text": "“My daughter sent you here?”",
          "listener": "odysseus"
        },
        {
          "id": "odyssey-c3-s3-p3",
          "type": "text",
          "kind": "dialogue",
          "who": "odysseus",
          "text": "“She found me by the river. She made this shore feel safe.”",
          "listener": "arete"
        },
        {
          "id": "odyssey-c3-s3-alcinous-joins-the-table",
          "type": "action",
          "duration": 2000,
          "camera": {
            "hold": true
          },
          "effects": {
            "actors": {
              "alcinous": {
                "x": 1005,
                "y": 940,
