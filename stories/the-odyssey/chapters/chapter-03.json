                "facing": "front"
              }
            }
          }
        },
        {
          "id": "odyssey-c3-s3-alcinous-turns-to-the-table",
          "type": "action",
          "duration": 650,
          "camera": {
            "hold": true
          },
          "effects": {
            "actors": {
              "alcinous": {
                "x": 955,
                "y": 940,
                "pose": "walk",
                "facing": "left"
              }
            }
          }
        },
        {
          "id": "odyssey-c3-s3-frame-the-welcome",
          "type": "action",
          "duration": 650,
          "effects": {
            "view": "welcome"
          }
        },
        {
          "id": "odyssey-c3-s3-p4",
          "type": "text",
          "kind": "narration",
          "who": null,
          "text": "Alcinous approached the table. The king looked first at the guest, then at the bread."
        },
        {
          "id": "odyssey-c3-s3-p5",
          "type": "text",
          "kind": "dialogue",
          "who": "alcinous",
          "text": "“Eat. We can ask our questions afterward.”",
          "listener": "odysseus"
        },
        {
          "id": "odyssey-c3-s3-accept-the-meal",
          "type": "action",
          "duration": 1200,
          "effects": {
            "bread": {
              "owner": "odysseus"
            },
            "actors": {
              "odysseus": {
                "pose": "reach",
                "facing": "right"
              }
            }
          }
        },
        {
          "id": "odyssey-c3-s3-p6",
          "type": "text",
          "kind": "narration",
          "who": null,
          "text": "Odysseus lifted the bread. No one asked him to earn it with a story."
        },
        {
          "id": "odyssey-c3-s3-p7",
          "type": "text",
          "kind": "dialogue",
          "who": "alcinous",
          "text": "“Our ships know these waters. When you are ready, we can help you leave them.”",
          "listener": "odysseus"
        },
        {
          "id": "odyssey-c3-s3-p8",
          "type": "text",
          "kind": "narration",
          "who": null,
          "text": "For the first time since the raft broke, home felt like a place he might reach."
        }
      ],
