                "facing": "left"
              }
            }
          }
        },
        {
          "id": "odyssey-c3-s2-p1",
          "type": "text",
          "kind": "narration",
          "who": null,
          "text": "Nausicaa had come down the path to wash clothes by the river. She stopped beside her basket when she saw the stranger."
        },
        {
          "id": "odyssey-c3-s2-p2",
          "type": "text",
          "kind": "narration",
          "who": null,
          "text": "Odysseus kept a little distance. He had frightened enough people in his life."
        },
        {
          "id": "odyssey-c3-s2-ask-with-open-hands",
          "type": "action",
          "duration": 750,
          "effects": {
            "view": "river-close",
            "actors": {
              "odysseus": {
                "pose": "reach",
                "facing": "right",
                "bow": 0
              }
            }
          }
        },
        {
          "id": "odyssey-c3-s2-p3",
          "type": "text",
          "kind": "dialogue",
          "who": "odysseus",
          "text": "“I have come from the sea. Is there somewhere I could find help?”",
          "listener": "nausicaa"
        },
        {
          "id": "odyssey-c3-s2-p4",
          "type": "text",
          "kind": "dialogue",
          "who": "nausicaa",
          "text": "“You have found someone who can offer it.”",
          "listener": "odysseus"
        },
        {
          "id": "odyssey-c3-s2-p5",
          "type": "text",
          "kind": "narration",
          "who": null,
          "text": "Her name was Nausicaa. Her parents, Alcinous and Arete, ruled this island, Scheria. She decided to help him."
        },
        {
          "id": "odyssey-c3-s2-take-food-from-the-basket",
          "type": "action",
          "duration": 1100,
          "effects": {
            "bread": {
              "x": 836,
              "y": 899,
              "visible": 1,
              "owner": "nausicaa"
            },
            "actors": {
              "nausicaa": {
                "pose": "reach"
              }
            }
          }
        },
        {
          "id": "odyssey-c3-s2-p6",
          "type": "text",
          "kind": "dialogue",
          "who": "nausicaa",
          "text": "“Rest a while. There is bread, and clean cloth for your shoulders.”",
          "listener": "odysseus"
        },
        {
          "id": "odyssey-c3-s2-step-close-enough-to-help",
          "type": "action",
          "duration": 1100,
          "effects": {
            "actors": {
              "nausicaa": {
                "x": 800,
                "y": 965,
                "pose": "walk",
                "facing": "left"
              }
            }
          }
        },
        {
          "id": "odyssey-c3-s2-pass-the-bread",
          "type": "action",
          "duration": 1450,
          "effects": {
            "bread": {
              "x": 721,
              "y": 904,
              "owner": "odysseus"
            },
            "cloak": {
              "x": 748,
              "y": 973,
              "visible": 1
            },
            "actors": {
              "odysseus": {
                "pose": "reach"
              }
            }
          }
        },
        {
          "id": "odyssey-c3-s2-p7",
          "type": "text",
          "kind": "narration",
          "who": null,
          "text": "She passed him the bread and laid the folded cloak beside him."
        },
        {
          "id": "odyssey-c3-s2-p8",
          "type": "text",
          "kind": "narration",
          "who": null,
          "text": "He had prepared words of gratitude. For a moment, he could only look at the food."
        },
        {
          "id": "odyssey-c3-s2-p9",
          "type": "text",
          "kind": "dialogue",
          "who": "nausicaa",
          "text": "“After you have rested, I will show you the way to my mother’s house.”",
          "listener": "odysseus"
        },
        {
          "id": "odyssey-c3-s2-clarity-follow-her",
          "type": "text",
          "kind": "narration",
          "text": "Odysseus rested and ate. Then Nausicaa led him up the river path toward her parents’ palace."
        },
        {
          "id": "odyssey-c3-s2-doc-follow-the-river-path",
          "type": "action",
