          "id": "odyssey-c1-s4-p7",
          "type": "text",
          "kind": "narration",
          "who": null,
          "text": "On the last day, a small sail stood above the timber. The raft was ready."
        },
        {
          "id": "odyssey-c1-s4-load-the-supplies",
          "type": "action",
          "duration": 1300,
          "effects": {
            "supplies": {
