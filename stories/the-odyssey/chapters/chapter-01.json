        {
          "id": "odyssey-c1-s5-p1",
          "type": "text",
          "kind": "narration",
          "who": null,
          "text": "When the wind was right, the raft reached the water. A little wave lifted it, then set it down again."
        },
        {
          "id": "odyssey-c1-s5-p2",
          "type": "text",
          "kind": "narration",
          "who": null,
          "text": "Odysseus stayed beside it for one last moment."
        },
        {
          "id": "odyssey-c1-s5-p3",
          "type": "text",
          "kind": "dialogue",
          "who": "calypso",
          "text": "“You may still stay.”"
        },
        {
          "id": "odyssey-c1-s5-p4",
          "type": "text",
          "kind": "dialogue",
          "who": "odysseus",
          "text": "“I know.”"
        },
        {
          "id": "odyssey-c1-s5-step-aboard",
          "type": "action",
          "duration": 1700,
          "effects": {
            "raft": {
              "aboard": 1
            },
            "actors": {
              "odysseus": {
                "x": 830,
                "y": 798,
                "facing": "back",
                "pose": "walk"
              }
            }
          }
        },
        {
          "id": "odyssey-c1-s5-p5",
          "type": "text",
          "kind": "narration",
          "who": null,
          "text": "He stepped aboard before fear could become another year."
        },
        {
          "id": "odyssey-c1-s5-p6",
          "type": "text",
          "kind": "narration",
          "who": null,
          "text": "Calypso watched from the sand. She did not reach out to stop him."
        },
        {
          "id": "odyssey-c1-s5-leave-the-shore",
          "type": "action",
          "duration": 4800,
          "effects": {
            "view": "departure",
